{
  "name": "checklist",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "test": "tsc -b && node --test 'tests/*.test.ts'",
    "dev": "tsc -b && (tsc -b --watch --preserveWatchOutput & node --watch server/server.ts)",
    "start": "node server/server.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "typescript": "7.0.2"
  }
}
